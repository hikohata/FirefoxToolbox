{
    "browser_specific_settings": {
      "gecko": {
        "id": "toolbox@hikohata",
        "data_collection_permissions": {
          "required": [
              "none"
          ]
        }
      }
    },
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "author": "Hiroyuki Kohata",
    "version": "1.0",
    "description": "__MSG_extensionDescription__",
    "permissions": [
      "activeTab",
      "scripting",
      "declarativeNetRequest",
      "clipboardWrite",
      "storage"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "48": "icons/icon.svg" 
      }
    },
    "icons": {
      "48": "icons/icon.svg"
    },
    "default_locale": "en"
  }